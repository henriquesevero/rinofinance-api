# HTTP server port. Railway injects this automatically in production;
# only needed for local development.
PORT=8080

# MongoDB Atlas connection string. Get this from Atlas > Connect > Drivers.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name within the MongoDB deployment.
MONGO_DATABASE=rinofinance

# Secret used to sign JWTs. Use a long random string in production
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued JWT stays valid (Go duration format).
JWT_TTL=24h

# Comma-separated list of origins allowed by CORS (the Vercel frontend
# URL(s) in production).
ALLOWED_ORIGINS=http://localhost:5173,https://rinofinance.vercel.app

# Pluggy Open Finance API credentials (Dashboard > Settings > API Keys).
# Empty disables the Pluggy sync integration.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Auto-update via webhook (optional). PLUGGY_WEBHOOK_URL is the PUBLIC https
# URL Pluggy calls when a connection refreshes — set it to your deployed API
# plus the webhook path and the secret as a ?token=, e.g.
#   https://your-api.up.railway.app/api/pluggy/webhook?token=<secret>
# When set, the server registers it with Pluggy on startup. Leave empty in
# local dev (localhost isn't reachable by Pluggy). PLUGGY_WEBHOOK_SECRET must
# match the ?token= value; incoming calls without it are rejected.
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=
